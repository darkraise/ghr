{
  "owner": "darkraise",
  "mode": "queue",
  "global_max": 2,
  "poll_interval": "10s",
  "start_timeout": "2m0s",
  "idle_timeout": "5m0s",
  "disk_high_water": 80,
  "build_cache_keep": "20GB",
  "history_retention": "30d",
  "labels": [
    "homelab"
  ],
  "runner_limits": {
    "memory_max": "6G",
    "cpu_quota": "200%"
  },
  "repos": [
    {
      "name": "darkmem",
      "max": 2,
      "warm": 1,
      "labels": [
        "gpu"
      ],
      "cleanup_name_prefixes": [
        "darkmem-"
      ]
    },
    {
      "name": "darkcloud",
      "paused": true
    }
  ],
  "watch_repos": [
    "docs",
    "old-docs"
  ],
  "web": {
    "listen": "0.0.0.0:8080",
    "hosts": [
      "ghr.lan"
    ]
  },
  "github_storage": {
    "cleanup_max_age": "2d",
    "repos": {
      "darkmem": {
        "cleanup": "6h"
      }
    }
  },
  "artifact_store": {
    "endpoint": "https://s3.example.sg",
    "bucket": "gha-artifacts",
    "region": "us-east-1",
    "cleanup_max_age": "7d",
    "capacity_gb": 50,
    "repos": {
      "darkcloud": {
        "enabled": true
      },
      "darkmem": {
        "enabled": true,
        "cleanup": "3d"
      }
    }
  },
  "jobs": {
    "ghr_update_check": {
      "enabled": true,
      "every": "1d"
    },
    "runner_update_check": {
      "enabled": true,
      "every": "1d"
    },
    "prune": {
      "enabled": true,
      "every": "1d"
    },
    "storage_measure": {
      "enabled": true,
      "every": "30m0s"
    }
  }
}
